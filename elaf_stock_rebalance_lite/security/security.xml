<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_rebalance" model="ir.module.category">
        <field name="name">Stock Rebalancing</field>
        <field name="sequence">46</field>
        <field name="parent_id" ref="base.module_category_inventory"/>
    </record>

    <record id="group_rebalance_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_rebalance"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
        <field name="comment">Runs stock rebalancing analyses and reads recommendations.</field>
    </record>

    <record id="group_rebalance_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_rebalance"/>
        <field name="implied_ids" eval="[(4, ref('group_rebalance_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Manages all runs of the allowed companies.</field>
    </record>

    <!-- Multi-company isolation -->
    <record id="rule_rebalance_run_company" model="ir.rule">
        <field name="name">Rebalance run: allowed companies</field>
        <field name="model_id" ref="model_elaf_rebalance_run"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rebalance_stat_company" model="ir.rule">
        <field name="name">Rebalance coverage: allowed companies</field>
        <field name="model_id" ref="model_elaf_rebalance_stat"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rebalance_line_company" model="ir.rule">
        <field name="name">Rebalance recommendation: allowed companies</field>
        <field name="model_id" ref="model_elaf_rebalance_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <!-- Users see and change their own runs; managers all runs of their companies -->
    <record id="rule_rebalance_run_user_own" model="ir.rule">
        <field name="name">Rebalance run: users modify own runs</field>
        <field name="model_id" ref="model_elaf_rebalance_run"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_rebalance_user'))]"/>
        <field name="perm_read" eval="False"/>
    </record>
    <record id="rule_rebalance_run_manager_all" model="ir.rule">
        <field name="name">Rebalance run: managers modify all runs</field>
        <field name="model_id" ref="model_elaf_rebalance_run"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_rebalance_manager'))]"/>
        <field name="perm_read" eval="False"/>
    </record>
</odoo>
